+    func testLostDocumentAcknowledgementNeverSendsCommand() async throws {
+        launcher.reply = nil
+        let channel = channel()
+        channel.beginDocument()
+        let send = channel.captureBridge()
+        let pending = Task { try await send(Data(#"{"cmd":"session.overlay.submit","args":{"value":"old"}}"#.utf8)) }
+        try await untilOrigin { !$0.isEmpty }
+        try await Task.sleep(for: .milliseconds(100))
+        XCTAssertEqual(origin.received.count, 1, "only activation may be sent before its acknowledgement")
+        channel.close("lost activation acknowledgement")
+        do { _ = try await pending.value; XCTFail("command must fail without acknowledgement") } catch { }
+        XCTAssertEqual(origin.received.count, 1)
+    }
+
+    func testCapturedBridgeCannotBorrowReplacementDocument() async throws {
+        let channel = channel()
+        channel.beginDocument()
+        let old = channel.captureBridge()
+        try await untilOrigin { !$0.isEmpty }
+        channel.appliedSequence = 3
+        channel.beginDocument()
+        do { _ = try await old(Data(#"{"cmd":"session.overlay.submit"}"#.utf8)); XCTFail("old document must fail") } catch { }
+        let current = channel.captureBridge()
+        _ = try await current(Data(#"{"cmd":"session.status","args":{"status":"idle"}}"#.utf8))
+        let requests = try origin.received.compactMap { frame -> [String: Any]? in
+            guard case .bridge(_, let json) = frame else { return nil }
+            return try JSONSerialization.jsonObject(with: Data(json.utf8)) as? [String: Any]
+        }
+        XCTAssertEqual(requests.filter { $0["request"] != nil }.count, 1)
+        XCTAssertEqual(requests.last?["document"] as? Int, 2)
+        XCTAssertEqual(requests.last?["appliedSeq"] as? Int, 3)
